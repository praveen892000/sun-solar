# Copy to .env and fill in values.

# PostgreSQL (local Docker: docker compose up -d)
# DATABASE_URL="postgresql://sunsolar:sunsolar@localhost:5432/sunsolar?schema=public"
#
# On Render this is injected from the linked database.
DATABASE_URL="postgresql://sunsolar:sunsolar@localhost:5432/sunsolar?schema=public"

# REQUIRED. Secret used to sign admin session JWTs (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Public site URL (canonical URLs / sitemap / OG tags).
# On Render this is set in render.yaml (or override in the dashboard).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin credentials (used by npm run db:seed / start:prod).
# CHANGE THE PASSWORD after first login in production.
SEED_ADMIN_EMAIL="admin@srisunsolar.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Site Admin"
